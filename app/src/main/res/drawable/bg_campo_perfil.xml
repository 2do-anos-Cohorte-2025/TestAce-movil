<?xml version="1.0" encoding="utf-8"?>
<!-- Campo redondeado del perfil: blanco con borde verde al poder editarse, gris suave si está bloqueado -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#F3EBDD" />
            <stroke android:width="1dp" android:color="@color/beige_oscuro" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/white" />
            <stroke android:width="2dp" android:color="@color/verde_claro" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
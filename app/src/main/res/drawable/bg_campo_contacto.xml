<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Campo seleccionado (escribiendo) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F3EBDD" />
            <stroke android:width="2dp" android:color="@color/verde_claro" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Campo en reposo -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F3EBDD" />
            <stroke android:width="1dp" android:color="@color/beige_oscuro" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TestAceMovil" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/verde_claro</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/beige_claro</item>
        <item name="colorOnPrimaryContainer">@color/verde_oscuro</item>

        <item name="colorSecondary">@color/rosa</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/rosa_claro</item>
        <item name="colorOnSecondaryContainer">@color/verde_oscuro</item>

        <item name="android:colorBackground">@color/beige_claro</item>
        <item name="colorOnBackground">@color/verde_oscuro</item>

        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorSurfaceVariant">@color/beige_claro</item>
        <item name="colorOnSurfaceVariant">@color/verde_oscuro</item>

        <item name="colorOutline">@color/beige_oscuro</item>
    </style>

    <style name="Theme.TestAceMovil" parent="Base.Theme.TestAceMovil" />

    <style name="Theme.TestAceMovil.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.TestAceMovil.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.TestAceMovil.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>